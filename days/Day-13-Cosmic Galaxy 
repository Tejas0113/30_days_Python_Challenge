
import turtle
import random
import math
import colorsys

screen = turtle.Screen()
screen.setup(900, 900)
screen.bgcolor("#050512")
screen.title("DAY 13 | COSMIC NEBULA")
screen.tracer(0)

pen = turtle.Turtle()
pen.hideturtle()
pen.speed(0)

# Background stars
for _ in range(350):
    x = random.randint(-440, 440)
    y = random.randint(-440, 440)
    size = random.choice([1, 2, 3])
    pen.penup()
    pen.goto(x, y)
    pen.dot(size, random.choice(
        ["white", "#8FA8FF", "#B8A0FF", "#63E8FF"]
    ))

# Nebula clouds
for i in range(850):
    angle = random.uniform(0, 2 * math.pi)
    radius = random.uniform(40, 340)

    x = math.cos(angle) * radius
    y = math.sin(angle) * radius * 0.65

    hue = (0.72 + radius / 1300 + random.uniform(-0.04, 0.04)) % 1
    color = colorsys.hsv_to_rgb(hue, 0.8, 1)

    pen.penup()
    pen.goto(x, y)
    pen.dot(random.randint(2, 8), color)

# Spiral galaxy
for arm in range(5):
    for i in range(170):
        angle = i * 0.075 + arm * 2 * math.pi / 5
        radius = 8 + i * 1.65

        x = math.cos(angle) * radius
        y = math.sin(angle) * radius * 0.75

        hue = (0.48 + i / 500 + arm * 0.08) % 1
        color = colorsys.hsv_to_rgb(hue, 0.65, 1)

        pen.penup()
        pen.goto(x, y)
        pen.dot(random.randint(2, 5), color)

# Bright central star
pen.goto(0, 0)
pen.dot(38, "#A7EFFF")
pen.dot(22, "#FFFFFF")

# Extra glowing stars
for _ in range(18):
    x = random.randint(-350, 350)
    y = random.randint(-350, 350)
    pen.penup()
    pen.goto(x, y)
    pen.dot(12, "#536DFF")
    pen.dot(5, "#FFFFFF")

screen.update()
screen.mainloop()
